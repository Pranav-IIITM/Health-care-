# Optional: Gemini as a second reader for clinicians' follow-up instructions.
# Copy this file to .env.local and add a key from Google AI Studio (free tier is enough).
#
# Free-tier prompts may be used by Google to improve its products and can be read by
# human reviewers. Use simulated data only. The app sends just the instruction text,
# with phone and registration numbers removed.
GEMINI_API_KEY=

# Any free-tier text model works. Default: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
